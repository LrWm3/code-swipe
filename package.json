{
  "name": "code-swipe-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "retrofit:presentation": "tsx scripts/retrofit-presentation.ts",
    "retrofit:skills": "tsx scripts/retrofit-skills.ts",
    "migrate:knowledge": "tsx scripts/migrate-knowledge.ts",
    "migrate:organization": "tsx scripts/migrate-organization.ts",
    "migrate:curricula": "tsx scripts/migrate-curricula.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.546.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
