# Local single-user server. Open the printed URL after npm run dev.
PORT=3000
# Optional local storage directory; defaults to .code-swipe/ in this project.
# CODE_SWIPE_DATA_DIR=/absolute/path/to/your/code-swipe-data
# Optional executable overrides. Otherwise binaries are found on PATH.
# Use an absolute path if your server and terminal find different CLI versions.
# Codex requires 0.153.4 or newer for the isolated tutor configuration.
# CODE_SWIPE_CODEX_BIN=codex
# CODE_SWIPE_OPENCODE_BIN=opencode
# CLI deadline override, in milliseconds (defaults: lessons 360000, discussions 180000).
# CODE_SWIPE_TUTOR_TIMEOUT_MS=360000
DISABLE_HMR=false
